{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif,ico,svg}", "/css/*", "/js/*", "/assets/*", "/api/*"]
  },
  "routes": [
    {
      "route": "/api/*",
      "rewrite": "https://ca-api-kiddo-prod-yotzp.blackpond-a683933c.centralus.azurecontainerapps.io/api/*"
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: http: data: blob: ws: wss:; font-src 'self' https: data:; img-src 'self' https: http: data: blob:; connect-src 'self' https: http: ws: wss:;"
  },
  "mimeTypes": {
    ".json": "text/json"
  }
}
